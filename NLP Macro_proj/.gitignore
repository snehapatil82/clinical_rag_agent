# Environment variables & secrets
.env
.streamlit/secrets.toml

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Vector store cache (generated at runtime, can be rebuilt)
# Note: Keep vector_store/.gitkeep if versioning the directory structure
vector_store/*.index
vector_store/*.json
vector_store/*.pkl
!vector_store/.gitkeep

# Evaluation output logs
evaluation_results_*.json
evaluation_results_*.csv
